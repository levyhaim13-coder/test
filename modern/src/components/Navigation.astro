---
import menu from '../../../menu.json';
import MenuItems from './MenuItems.astro';
---

<table id="topMenuContainer" class="topMenuContainer" cellpadding="0" cellspacing="0" border="0">
	<tbody>
	<tr>
	<td>
	<MenuItems items={menu} root />
	</td>
	</tr>
	</tbody>
</table>

<script>
	const menu = document.querySelector<HTMLElement>('#MenuBar2');

	if (menu) {
		for (const item of menu.querySelectorAll<HTMLElement>('li')) {
			const submenu = item.querySelector<HTMLElement>(':scope > ul');
			if (!submenu) continue;

			item.addEventListener('mouseenter', () => {
				const menuBounds = menu.getBoundingClientRect();
				const itemBounds = item.getBoundingClientRect();
				const submenuWidth =
					submenu.getBoundingClientRect().width ||
					Number.parseFloat(getComputedStyle(submenu).width) ||
					120;
				const isTopLevel = item.parentElement === menu;

				if (isTopLevel) {
					const wouldOverflowLeft = itemBounds.right - submenuWidth < menuBounds.left;
					submenu.style.right = wouldOverflowLeft ? 'auto' : '0';
					submenu.style.left = wouldOverflowLeft ? '0' : 'auto';
					return;
				}

				const wouldOverflowLeft = itemBounds.left - submenuWidth < menuBounds.left;
				submenu.style.right = wouldOverflowLeft ? 'auto' : '100%';
				submenu.style.left = wouldOverflowLeft ? '100%' : 'auto';
			});
		}
	}
</script>
