---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('pages', ({ data }) => !data.isHome);
const searchIndex = entries.map(({ data, body }) => ({
	 title: data.title,
	 description: data.description ?? '',
	 keywords: data.keywords ?? '',
	 url: data.legacyPath,
	 content: body ?? '',
}));
const serializedIndex = JSON.stringify(searchIndex).replace(/</g, '\\u003c');
---

<BaseLayout title="חיפוש באתר" canonicalPath="/test/search.html">
	<table class="legacy-title" border="0" cellpadding="0" cellspacing="0" width="100%">
		<tbody><tr><td><h1>חיפוש באתר</h1></td></tr></tbody>
	</table>
	<section class="search-page" aria-live="polite">
		<p id="search-status">הקלד/י מילת חיפוש כדי למצוא עמודים באתר.</p>
		<ul id="search-results"></ul>
	</section>
</BaseLayout>

<script type="application/json" id="search-index" set:html={serializedIndex}></script>
<script>
	const indexElement = document.querySelector('#search-index');
	const resultsElement = document.querySelector('#search-results');
	const statusElement = document.querySelector('#search-status');
	const entries = JSON.parse(indexElement?.textContent || '[]');
	const query = new URLSearchParams(window.location.search).get('q')?.trim() || '';

	const normalize = (value) => value.toLocaleLowerCase('he');
	const stripMarkup = (value) => {
		const element = document.createElement('div');
		element.innerHTML = value;
		return element.textContent || '';
	};

	if (query) {
		const needle = normalize(query);
		const matches = entries.filter((entry) => normalize(
			`${entry.title} ${entry.description} ${entry.keywords} ${stripMarkup(entry.content)}`,
		).includes(needle));
		statusElement.textContent = `${matches.length} תוצאות עבור "${query}"`;
		matches.forEach((entry) => {
			const item = document.createElement('li');
			const link = document.createElement('a');
			link.href = entry.url;
			link.textContent = entry.title;
			item.append(link);
			resultsElement.append(item);
		});
	} else {
		statusElement.textContent = 'הקלד/י מילת חיפוש כדי למצוא עמודים באתר.';
	}
</script>
